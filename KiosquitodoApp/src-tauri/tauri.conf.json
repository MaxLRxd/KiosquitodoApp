{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KiosquitodoApp",
  "version": "0.1.0",
  "identifier": "com.kiosquitodo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Kiosquitodo — Gestión de Kiosco",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERTAwMTZEQTkzODFGOUYKUldTZkh6aXBiUUhnamUrWWFBYVNnV1ltdDZ3Q0hkR2FZcWV1VUV4cythMHhaZW9tQW9oUnJGY00K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}